# Copy to .env (never commit .env). The app reads real environment variables;
# on Render set these in the dashboard.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# CORS_ORIGIN_REGEX=https://.*\.vercel\.app
# DATABASE_PATH=./data/predictions.db
# Cloud database (PostgreSQL). Leave empty locally -> SQLite file is used.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
